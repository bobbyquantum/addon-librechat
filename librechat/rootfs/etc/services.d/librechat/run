#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
cd /opt/librechat || exit
bashio::log.info "Starting LibreChat Backend"

# Create persistent images directory if it doesn't exist
mkdir -p /data/images

# Create a symlink from the application's images directory to the persistent data directory
# Remove existing directory first to ensure the symlink works
rm -rf /opt/librechat/client/public/images
ln -s /data/images /opt/librechat/client/public/images

#if there isn't a default env file, then copy one.
if [ ! -f /config/.env ]; then
    cp .env.example /config/.env
fi

# LibreChat refuses to start with the JWT secrets that older .env.example files
# shipped. Replace only those: rotating them just signs people out. CREDS_KEY and
# CREDS_IV encrypt stored user keys, so they are never changed here.
rotate_retired_secret() {
    local name=$1 retired_sha256=$2 value
    value=$(sed -n "s/^${name}=//p" /config/.env | tail -n 1 | tr -d "\"' \r")
    [[ -n "$value" ]] || return 0
    [[ "$(printf '%s' "$value" | sha256sum | cut -d' ' -f1)" == "$retired_sha256" ]] || return 0
    bashio::log.warning "Replacing the retired default ${name} in /config/.env. Everyone will need to sign in again."
    sed -i "s/^${name}=.*/${name}=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')/" /config/.env
}
rotate_retired_secret JWT_SECRET 69024f21e9ad17594dcccd93e87399af24a5426ccfe6108d1787f0335966abc4
rotate_retired_secret JWT_REFRESH_SECRET 282ad5f60261639fefed381976b4d0dde52eab5527a1ab2ec75d5be1efa1165b

# Secrets left blank in .env are generated by LibreChat. Keep them in /config so
# they survive add-on updates, which replace the container.
export LIBRECHAT_TEMP_CREDENTIALS_PATH=/config/.env.temp

#copy whatever is in env before running.
cp /config/.env .env

exec npm run backend
